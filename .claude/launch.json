{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-os-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "web"],
      "port": 8081
    },
    {
      "name": "studio-os-backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run", "--no-launch-profile", "--project", "backend/StudioManagement.API", "--",
        "--urls", "http://0.0.0.0:5237", "--environment", "Development"
      ],
      "port": 5237
    }
  ]
}
