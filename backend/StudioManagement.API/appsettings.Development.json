{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StudioManagementDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Sms": {
    "Provider": "Log"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "StudioManagement.Business.Email.LoggingEmailSender": "Debug",
        "StudioManagement.Business.Sms.LoggingSmsSender": "Debug"
      }
    }
  }
}
