{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "TimeZone": "India Standard Time"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "StudioOS",
    "Audience": "StudioOSClients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDaysDefault": 1,
    "RefreshTokenExpiryDaysRemembered": 30
  },
  "RateLimits": {
    "PerUserPerMinute": 600,
    "PerUserBurst": 300,
    "ExpensivePerMinute": 60,
    "ExpensiveBurst": 30,
    "UploadPerMinute": 1200,
    "UploadBurst": 300,
    "LoginPerIp": 20,
    "AuthPerIp": 5,
    "RefreshPerIp": 60,
    "PublicGalleryPerIp": 300,
    "CheckoutPerIp": 20
  },
  "RequestLimits": {
    "MaxJsonBodyBytes": 1048576
  },
  "PhotoGallery": {
    "StudioRootBase": "",
    "DefaultCountryCode": "",
    "PreviewRetentionDays": 10,
    "PreviewMaxDimension": 1600,
    "PreviewQuality": 70,
    "ThumbnailMaxDimension": 360,
    "ThumbnailQuality": 65
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "wwwroot/uploads"
    },
    "SignedUrlHours": 24
  },
  "Payments": {
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },
  "WhatsApp": {
    "Provider": "Log",
    "PhoneNumberId": "",
    "AccessToken": "",
    "ApiVersion": "v20.0",
    "DefaultCountryCode": "",
    "HoursBefore": 24,
    "ReminderTime": "09:00",
    "FunctionDetailsTemplate": "",
    "PaymentDetailsTemplate": "",
    "TemplateLanguage": "en",
    "MaxAttempts": 3
  },
  "PasswordReset": {
    "CodeExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MaxCodesPerHour": 5,
    "ResetTokenMinutes": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
