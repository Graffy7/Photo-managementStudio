{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StudioManagementDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Jwt": {
    "Issuer": "StudioOS",
    "Audience": "StudioOSClients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDaysDefault": 1,
    "RefreshTokenExpiryDaysRemembered": 30
  },
  "PasswordReset": {
    "ExpiryMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
